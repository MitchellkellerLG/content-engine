# Copy to .env and fill in only what you use. Never commit .env.
# Python scripts read the shell environment:  set -a; . ./.env; set +a
# Trigger.dev jobs read the env vars you set in the Trigger.dev dashboard.

# ---- voice/ and gather/ ---------------------------------------------------
# Read-only app bearer token (voice/pull_posts.py x-api)
X_BEARER_TOKEN=
# OAuth 2.0 user token with bookmark.read + tweet.read + users.read (gather/bookmarks.py)
X_OAUTH2_USER_TOKEN=
# Space-separated GitHub users/orgs to include, and optional priority/exclude repo names
GITHUB_OWNERS=
GITHUB_PRIORITY=
GITHUB_EXCLUDE=
# Any CLI that reads a prompt on stdin and prints a reply, e.g. "claude -p" or "codex exec -"
LLM_CMD=

# ---- repurpose/ -----------------------------------------------------------
# Optional: path to a Chrome/Chromium binary if Playwright's bundled browser isn't installed
CHROME_PATH=
# Typefully's own CLI reads this (see repurpose/typefully.md)
TYPEFULLY_API_KEY=

# ---- automations/ (set these in the Trigger.dev dashboard) ----------------
# Your numeric X user id and handle (without @)
X_USER_ID=
X_HANDLE=
# OAuth 1.0a user-context keys for the account the jobs act on
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Any Postgres: postgres://user:password@host:5432/dbname
DATABASE_URL=
# Your Trigger.dev project ref (used by trigger.config.ts at deploy time)
TRIGGER_PROJECT_REF=
# Slack or Discord incoming webhook for notifications
NOTIFY_WEBHOOK_URL=

# Plug: off by default. notify = message you; reply = post the reply via the API
PLUG_ENABLED=false
PLUG_MODE=notify
PLUG_MIN_IMPRESSIONS=1000
PLUG_CHECK_AFTER_MINUTES=120
PLUG_CHECK_MAX_LATE_MINUTES=240

# Auto-repost: off by default. Bumps need their own switch. Read docs/x-rules.md first.
AUTO_RT_ENABLED=false
AUTO_RT_BUMPS_ENABLED=false
AUTO_RT_FIRST_HOURS=4
AUTO_RT_BUMPS=1
AUTO_RT_BUMP_EVERY_HOURS=4
AUTO_RT_DAILY_WRITE_CAP=6
